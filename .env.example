# Copy to .env and fill in. NEVER commit .env.
#
#   cp .env.example .env
#
# Generate a development JWT secret (HMAC, phase 2 replaces this with RS256):
#   openssl rand -hex 32

DB_NAME=fuelpulse_db
DB_USER=fuelpulse_user
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

REDIS_HOST=localhost
REDIS_PORT=6379

JWT_SECRET=

SPRING_PROFILES_ACTIVE=dev
